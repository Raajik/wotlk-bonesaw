#!/usr/bin/env bash
# Start the Bonesaw 3.3.5a client under Wine, optionally logging in for you.
#
#   bonesaw                 launch (auto-login if credentials are stored)
#   bonesaw --set-login     store account + password in the login keyring
#   bonesaw --forget-login  remove them
#   bonesaw --no-login      launch without auto-login
#   bonesaw --set-dir DIR   remember where the client lives
#
# The password is kept in the Secret Service keyring (gnome-keyring, KWallet),
# never on disk, and is handed to wtype on stdin so it never appears in argv
# where ps would show it. Only the account name reaches Config.wtf, which is
# what the client already stores itself.
#
# Requires: wine, wtype, libsecret (secret-tool), and a running Secret Service.
set -euo pipefail

STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bonesaw"
ACCOUNT_FILE="$STATE_DIR/account"
GAMEDIR_FILE="$STATE_DIR/gamedir"
WM_CLASS="wow.exe"

# Seconds to wait after the game window takes focus before typing. A late
# keystroke is harmless -- the client drops it and you log in by hand. Raise it
# if the login screen is slow to appear on your machine.
SETTLE="${BONESAW_SETTLE:-9}"
WINDOW_TIMEOUT="${BONESAW_WINDOW_TIMEOUT:-60}"

die() { echo "bonesaw: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

resolve_game_dir() {
    if [[ -n "${BONESAW_DIR:-}" ]]; then echo "$BONESAW_DIR"; return; fi
    if [[ -f "$GAMEDIR_FILE" ]]; then head -n1 "$GAMEDIR_FILE"; return; fi
    echo "$HOME/Games/World of Warcraft/3.3.5/Bonesaw"
}

set_dir() {
    local dir="${1:?usage: bonesaw --set-dir DIR}"
    [[ -f "$dir/Wow.exe" ]] || die "no Wow.exe in $dir"
    mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"
    printf '%s\n' "$dir" > "$GAMEDIR_FILE"
    echo "Client directory set to $dir"
}

set_login() {
    have secret-tool || die "secret-tool not installed (package: libsecret)"
    local acct pw
    read -r -p "Account name: " acct
    [[ -n "$acct" ]] || die "no account name given"
    read -r -s -p "Password: " pw; echo
    [[ -n "$pw" ]] || die "no password given"
    # 3.3.5a truncates to 16 characters and uppercases, so a longer secret from
    # a password manager would silently not be what the client sends.
    (( ${#pw} <= 16 )) || die "3.3.5a truncates passwords to 16 characters"
    printf '%s' "$pw" | secret-tool store --label="Bonesaw ($acct)" \
        service bonesaw account "$acct"
    mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"
    printf '%s\n' "$acct" > "$ACCOUNT_FILE"; chmod 600 "$ACCOUNT_FILE"
    echo "Stored. 'bonesaw' will now log in as $acct."
}

forget_login() {
    local acct=""
    [[ -f "$ACCOUNT_FILE" ]] && acct=$(<"$ACCOUNT_FILE")
    if [[ -n "$acct" ]]; then
        secret-tool clear service bonesaw account "$acct" 2>/dev/null || true
    fi
    rm -f "$ACCOUNT_FILE"
    echo "Auto-login credentials removed."
}

# The client prefills the account field from Config.wtf at login-screen init,
# so the launcher never types the account name. Only safe with the game closed:
# WoW rewrites this file wholesale on a clean exit.
prefill_account() {
    local acct="$1" cfg="$2/WTF/Config.wtf"
    [[ -f "$cfg" ]] || return 0
    if grep -qi '^SET accountName ' "$cfg"; then
        sed -i "s/^SET accountName .*/SET accountName \"$acct\"/I" "$cfg"
    else
        printf 'SET accountName "%s"\n' "$acct" >> "$cfg"
    fi
}

focused_is_game() {
    have hyprctl || return 1
    hyprctl activewindow -j 2>/dev/null | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("class",""))
except Exception: print("")' 2>/dev/null | grep -qx "$WM_CLASS"
}

# Mirrors the Windows launcher: the client has already focused the account
# field with the prefilled name, so one Tab reaches the password field.
# Everything is guarded on the game holding focus, because a stray keystroke
# here lands in whatever the player has in front of them.
autologin() {
    local acct="$1"
    have wtype || { echo "bonesaw: wtype not installed, skipping auto-login" >&2; return; }
    have secret-tool || return

    local deadline=$((SECONDS + WINDOW_TIMEOUT))
    while (( SECONDS < deadline )); do
        focused_is_game && break
        sleep 1
    done
    focused_is_game || { echo "bonesaw: game never took focus, skipping auto-login" >&2; return; }

    sleep "$SETTLE"

    # Re-check right before typing: the player may have alt-tabbed away during
    # the settle, and the password must never go to another window.
    focused_is_game || { echo "bonesaw: focus left the game, skipping auto-login" >&2; return; }

    local pw
    if ! pw=$(secret-tool lookup service bonesaw account "$acct" 2>/dev/null) || [[ -z "$pw" ]]; then
        echo "bonesaw: no stored password for $acct, skipping auto-login" >&2
        return
    fi

    wtype -k Tab
    printf '%s' "$pw" | wtype -
    unset pw
    wtype -k Return
}

case "${1:-}" in
    --set-login)    set_login; exit 0 ;;
    --forget-login) forget_login; exit 0 ;;
    --set-dir)      shift; set_dir "${1:-}"; exit 0 ;;
    --no-login)     shift; NO_LOGIN=1 ;;
    -h|--help)      sed -n '2,15p' "$0" | sed 's/^# \?//'; exit 0 ;;
esac

GAME_DIR="$(resolve_game_dir)"
[[ -f "$GAME_DIR/Wow.exe" ]] || die "no Wow.exe in $GAME_DIR (set it with: bonesaw --set-dir DIR)"
have wine || die "wine is not installed"

export WINEPREFIX="${WINEPREFIX:-$HOME/.local/share/wineprefixes/bonesaw}"
export WINEDEBUG="${WINEDEBUG:--all}"
# WoW needs neither .NET nor IE; without this Wine offers to install them.
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=}"

ACCOUNT=""
if [[ -z "${NO_LOGIN:-}" && -f "$ACCOUNT_FILE" ]]; then
    ACCOUNT=$(<"$ACCOUNT_FILE")
    [[ -n "$ACCOUNT" ]] && prefill_account "$ACCOUNT" "$GAME_DIR"
fi

cd "$GAME_DIR"
if [[ -n "$ACCOUNT" ]]; then
    wine Wow.exe "$@" &
    game_pid=$!
    autologin "$ACCOUNT"
    wait "$game_pid"
else
    exec wine Wow.exe "$@"
fi
