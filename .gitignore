#
# AzerothCore
#

.cache
/conf/*
!/conf/dist
/modules/*
!/modules/*.md
!/modules/*.sh
!/modules/CMakeLists.txt
!/modules/*.h
!/modules/*.cmake
!/modules/mod-living-gear/
# scratch/backup copies left in src/ during development — never ship these
/modules/mod-living-gear/src/*.cpp.*
/modules/mod-living-gear/src/_*
/build*/
/var/*
!/var/build/.gitkeep
!/var/ccache/.gitkeep
/env/dist/*
!/env/dist/.gitkeep
/env/user/*
/.env*
/apps/joiner
/deps/deno
/data/sql/custom/*
# ...except Bonesaw's own custom SQL. Upstream ignores this directory because
# upstream expects it to hold a server owner's local hacks. Bonesaw keeps real,
# load-bearing schema here -- ap_full_schema.sql alone creates 22 attunement
# tables -- and a clone that lacks it cannot build the databases.
!/data/sql/custom/db_auth
!/data/sql/custom/db_characters
!/data/sql/custom/db_world
/src/server/scripts/Custom/*
!/src/server/scripts/Custom/README.md

/*.override.yml
/*.override.yaml

!.gitkeep

# default build directory if not specified by CMAKE configuration
/out/*

#
#Generic
#

.directory
.mailmap
*.orig
*.rej
*~
.hg/
*.kdev*
.DS_Store
CMakeLists.txt.user
*.bak
*.patch
*.diff
*.REMOTE.*
*.BACKUP.*
*.BASE.*
*.LOCAL.*

#
# Claude
#
.claude/worktrees
.claude/settings.local.json
.claude/plans/**

#
# IDE & other software
#
/.settings/
/.externalToolBuilders/*
/.vs
/out
# exclude in all levels
nbproject/
.sync.ffs_db
*.kate-swp
.browse.VC*
.idea
cmake-build-*/*
coverage-report/
.vs

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

#
# Eclipse
#
*.pydevproject
.metadata
.gradle
tmp/
*.tmp
*.swp
*~.nib
local.properties
.settings/
.loadpath
.project
.cproject

# vcpkg integration
/vcpkg/
/vcpkg-ports/

# Python bytecode cache
__pycache__/
*.py[cod]


# ==================
#
#  CUSTOM
#
#  put below your custom ignore rules
#  for example , if you want to include a
#  module directly in repositoryyou can do:
#
#  !modules/yourmodule
#
# ==================
.cache
compile_commands.json

# Discord Incoming Webhook secrets (Bonesaw patch-notes MCP)
*.webhook
!*.webhook.example
tools/client-update/discord.webhook

# SOAP GM credentials for tools/save_world.ps1 (never commit)
tools/soap.env
tools/client-update/soap.env

# worldserver image spelunking: extracted container layer + its tarball (1.2G)
/tools/ws-layer.tar
/tools/ws-extract/

# build transcripts kept for a single session
/build-*.txt
/build-*.log

# planning-with-files session state (SOP per AGENTS.md; never commit)
/task_plan.md
/findings.md
/progress.md
/.planning/
/HANDOFF.md

# Restored server data (migrated from Windows Docker Desktop volumes).
# 9GB MySQL datadir + 3GB client data -- never commit these.
/data/mysql/
/data/client-data/

# Transient build/ship logs. These used to accumulate in the repo root, one per
# ship, until `git status` was too noisy for the ship preflight's "working tree
# must be clean" check to mean anything. Write new ones under .logs/.
/.logs/
/.build*.log
/.build*.err.log
/.ship*.log
/.ship*.err.log
/.crash*.log
/.sweep-*
# Created by running PowerShell's `> $null` idiom in a shell where it is just a
# filename. Ignored so it stops coming back as a phantom untracked file.
/$null

# ==================
#  FORK MIGRATION (2026-09-02)
#
#  This repo is now a real fork of mod-playerbots/azerothcore-wotlk (branch
#  Playerbot, baseline recorded in UPSTREAM_BASELINE). The whole buildable tree
#  is tracked. Upstream ignores every module directory because upstream expects
#  them to be separate clones; Bonesaw vendors its modules so that a fresh
#  clone can build without extra steps, so they are re-included below.
# ==================

# Vendored modules (upstream's /modules/* rule would otherwise hide these)
!/modules/mod-living-gear
!/modules/mod-playerbots
!/modules/mod-ale

# Upstream module template, not part of the build
/tools/_skeleton-module/

# Local-only working directories, never part of a clone
/azerothcore/
/archive/
/bin/
/ws-image.tar
/Spell.dbc
/tmp_*.py
/.hermes/
/0

# Client build artifacts: regenerated by tools/client-patch/build_patch.py and
# tools/launcher/build_launcher.py. The launcher exe is not byte-reproducible,
# so these must never be committed.
/tools/client-patch/cache/
/tools/client-patch/dist/
/tools/client-patch/staging/
/tools/launcher/target/
/tools/launcher/payload/*.MPQ
