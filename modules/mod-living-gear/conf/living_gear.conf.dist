###############################################
# Living Gear
###############################################

# Enable the module
LivingGear.Enable = 1

# XP per kill type
LivingGear.XpPerKill = 1
LivingGear.XpEliteKill = 3
LivingGear.XpBossKill = 10

# Hard cap on item level
LivingGear.MaxLevel = 50

# Power per level: (base + roll) * (1 + (level-1) * this)
# 0.10 = +100% every 10 levels. Level 10 ~2x, 30 ~4x, 50 ~6x (+500% over base).
LivingGear.GrowthPerLevel = 0.10

# Legacy: fraction of grown stats banked by the old one-time "Attune"
# sacrifice. Unused by the 2026-08-20 continuous-attunement redesign (see
# LivingGear.Attune.* below) -- kept only because the underlying
# sacrifice code path still technically exists, even though nothing in the
# client sends it anymore.
LivingGear.AbsorbPct = 0.10

# Chance (0-100) that a new eligible item rolls bonus random stats
LivingGear.RollChance = 25

# Continuous attunement (2026-08-20): equipped (and Curator-tracked) gear
# banks a live slice of its own current stats into the account on every
# level-up, instead of being destroyed via a manual "Attune" button. The
# banked slice ramps from 1% of the item's current stats at level 1 to
# 100% at CapLevel -- past CapLevel the item keeps growing its own worn
# stats (up to LivingGear.MaxLevel) but stops adding anything further to
# the account.
LivingGear.Attune.CapLevel = 25

# The real WoW item level at which the level-1..CapLevel XP curve hits its
# "designed" pace -- an item at this ilvl should reach CapLevel in roughly
# 15-30 min of casual kill-grinding. Lower-ilvl items cost proportionally
# less XP per level (faster to max), higher-ilvl items cost more
# (slower) -- see LivingGear.Attune.IlvlFloorScale for the floor.
LivingGear.Attune.IlvlBaseline = 70.0

# Floor on the ilvl scaling factor above (as a fraction of the baseline
# item's per-level cost) -- keeps very low ilvl items from costing an
# unrealistic near-zero XP to max out.
LivingGear.Attune.IlvlFloorScale = 0.15

# How many primary stats a successful roll adds (1-5)
LivingGear.RollStatCount = 1

# Zone scaling: overleveled players deal less and take more in open world.
LivingGear.ZoneScale.Enable = 1
LivingGear.ZoneScale.CombatBuffer = 3
LivingGear.ZoneScale.MinPlayerLevel = 10
LivingGear.ZoneScale.RewardFloor = 0.35
LivingGear.ZoneScale.RewardGapDecay = 12.0
LivingGear.ZoneScale.IncomingPerLevel = 0.12

# Mount: instant cast, use highest known mount speed, auto-mount after combat.
LivingGear.InstantMount = 1
LivingGear.UniformMountSpeed = 1
LivingGear.AutoMount = 1

# Dungeon clear timer par (seconds) when lg_dungeon_par has no row.
LivingGear.DungeonTimer.DefaultParSec = 1800

# Curator: Living Gear XP tick to 5 lowest stored pieces.
LivingGear.CollectionPassive.TickMs = 60000

# Quest XP scaling. Quest rewards are recomputed as though the quest had been
# authored for the player's own level, so outlevelling a zone does not turn its
# quest chains into scraps. FloorPct then guarantees a minimum payout as a
# percentage of the current level's XP bar, which catches quests whose rescaled
# value still reads as noise. Repeat turn-ins of a repeatable quest are always
# left at zero and never get the floor.
LivingGear.QuestScale.Enable = 1
LivingGear.QuestScale.FloorPct = 4

# Creature damage-school immunity from creature_template is downgraded to an
# 80% resist, so "immune to Frost" mobs stop existing while still shrugging off
# most of the hit. Boss-script invulnerability (a real aura) and every player
# immunity are unaffected. See core-patch 0017.
LivingGear.SoftenCreatureImmunity = 1

# Waive weapon, positioning and reagent requirements on spells players cast.
# All three are the same rule wearing different hats -- "not with that weapon",
# "not from in front", "not without the component" -- and none of them make a
# fight more interesting here. Ambush and Backstab work without a dagger and
# from any angle, and buffs stop demanding you carry a bag of components.
# Crafting still costs its materials -- profession spells list those as
# reagents, so waiving them there would mean free Titansteel, not less
# errand. Creature casts are untouched; disarm still works. Core-patch 0020.
LivingGear.IgnoreSpellRequirements = 1

# Learn, at login, any CASTABLE perk the account owns that this character is
# missing. Perks belong to the account but spells are learned per character,
# and for a long time only the first character on an account ever got them --
# *Quests - Finish was missing from 894 characters, Auto-Mount from 733,
# Solo Queue from 723. Those are real buttons the player earned and could not
# see.
#
# Castable only, deliberately. The rest of the 910xxx range is badges with no
# SkillLineAbility row, so learning one puts nothing in the spellbook and
# changes no behaviour -- HasPerk reads the account set either way. Learning
# all of them would just mean ~100 "you have learnt" packets per login for
# nothing. Bounded to the 15 castable perks it is at most 15, once.
LivingGear.ReconcilePerkSpells = 1

# Kill XP floor (bug report #11). Every kill is worth at least this percentage
# of the current level's XP bar, so trash far below you still pays something.
# Zone scaling still governs anything worth more than the floor. Quest XP has
# its own separate floor above and is not affected by this.
LivingGear.KillXpFloor.Enable = 1
LivingGear.KillXpFloor.Pct = 1

# Quest items always drop (bug report #12). Covers loot entries flagged as quest
# drops, and ordinary items that are an objective of a quest the looting player
# is currently on. Players not on the quest see normal drop rates.
LivingGear.QuestDropAlways = 1

# Zone scaling inside dungeons (bug report #6). Scales UP only: a dungeon you
# have outlevelled is brought up to you, one above your level is left alone.
# Battlegrounds and arenas are never scaled.
LivingGear.ZoneScale.Dungeons = 1

# Learn every class ability your trainer would teach, free, on level up
# (bug report #1).
LivingGear.AutoTrainClassSpells = 1

# Wintergrasp siege damage scales up when the zone is underpopulated
# (bug report #3). At or above FullRoster nothing changes; below it, damage is
# multiplied by FullRoster/present, capped at MaxSiegeMult.
LivingGear.Wintergrasp.SiegeScale = 1
LivingGear.Wintergrasp.FullRoster = 20
LivingGear.Wintergrasp.MaxSiegeMult = 10.0
